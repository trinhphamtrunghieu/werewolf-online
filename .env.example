# Lấy trong Supabase -> Project Settings -> API (hoặc cài tích hợp Supabase trên Vercel).
# Bỏ trống khi chạy local: dev server sẽ lưu phòng trong RAM và giả lập Realtime.
SUPABASE_URL=
# Chỉ dùng ở server. Có thể dùng SUPABASE_SECRET_KEY (sb_secret_...) thay thế.
SUPABASE_SERVICE_ROLE_KEY=
# Key công khai cho trình duyệt nghe Realtime. Có thể dùng SUPABASE_PUBLISHABLE_KEY.
SUPABASE_ANON_KEY=
